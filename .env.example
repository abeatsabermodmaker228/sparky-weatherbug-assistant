# .env.example
# Copy this file to .env and add your actual API keys

# WeatherBug API Key (Recommended - Get from https://www.weatherbug.com/api)
WEATHERBUG_API_KEY=your_weatherbug_api_key_here

# OR OpenWeatherMap API Key (Fallback - Get from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Optional: Default location if no location is specified
# DEFAULT_LOCATION=London
